# Copier en .env puis adapter. Ce fichier n'est jamais commite.

# Adresse publique du serveur de mises a jour, sans / final.
# Doit etre identique a "urlServeur" de launcher.config.json.
URL_PUBLIQUE=https://play.example.com

# Ou nginx ecoute sur la machine hote.
#   80                 nginx seul, directement expose (HTTP)
#   127.0.0.1:8080     derriere un reverse proxy (Caddy, Traefik...) ou avec le profil https
HTTP_ECOUTE=80

# Profil https (docker compose --profile https up -d) : nom de domaine et e-mail Let's Encrypt.
# Avec ce profil, mettre HTTP_ECOUTE=127.0.0.1:8080 : Caddy prend les ports 80 et 443.
DOMAINE=play.example.com
EMAIL_ACME=admin@example.com
